{
  "$schema": "../../../../../node_modules/nx-electron/src/validation/maker.schema.json",
  "npmRebuild": false,
  "asarUnpack": ["node_modules/node-pty/**", "node_modules/@anthropic-ai/**"],
  "directories": {
    "buildResources": "apps/desktop/buildResources"
  },
  "win": {
    "icon": "icon.ico"
  },
  "mac": {
    "icon": "icon.icns"
  },
  "linux": {
    "target": ["AppImage"],
    "executableName": "ascua",
    "category": "Development",
    "executableArgs": ["--ozone-platform=x11"],
    "icon": "icon.png"
  },
  "extraResources": [{ "from": "dist/apps/indexer", "to": "indexer" }],
  "files": [{ "from": "desktop", "to": "desktop", "filter": ["pty-host.js"] }]
}
