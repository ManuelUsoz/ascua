{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@ascua/character": ["libs/character/src/index.ts"],
      "@ascua/ipc": ["libs/ascua-ipc/src/index.ts"],
      "@ascua/source-control": ["libs/source-control/src/index.ts"],
      "@ascua/source-control/github": ["libs/source-control/src/github/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
